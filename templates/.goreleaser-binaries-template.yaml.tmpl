## macOS binary template for signed + notarized artifacts, pushes to public registry (S3 bucket)
## Note: linux builds moved to the dedicated goreleaser-linux job so they can compile in
## parallel on an ubuntu runner; the macOS runner only handles targets that need codesign/notarize.
## Note: Windows builds moved to dedicated goreleaser-windows job for MSI support.
version: 2
project_name: "${REPO_NAME}"
builds:
  - binary: "${REPO_NAME}"
    env:
      - CGO_ENABLED=0
    id: macos-amd64
    main: "${GO_MAIN_PACKAGE}"
    goos:
      - darwin
    goarch:
      - amd64
    hooks:
      post:
        - gon ../_workflows/_generated/.gon-amd64.json
  - binary: "${REPO_NAME}"
    env:
      - CGO_ENABLED=0
    id: macos-arm64
    main: "${GO_MAIN_PACKAGE}"
    goos:
      - darwin
    goarch:
      - arm64
    hooks:
      post:
        - gon ../_workflows/_generated/.gon-arm64.json
archives:
  - id: darwin-archive
    builds:
      - macos-amd64
      - macos-arm64
    format: zip
    name_template: "{{ .ProjectName }}-v{{ .Version }}-{{ .Os }}-{{ .Arch }}"
    files:
      - none*
release:
  ids:
    - darwin-archive
snapshot:
  version_template: "{{ incpatch .Version }}-dev"
checksum:
  # Note: checksums are NOT uploaded here - they're merged with the linux and Windows
  # hashes and uploaded by the publish-release-manifest job.
  ids:
    - darwin-archive
sboms:
  - artifacts: archive
signs:
  - id: cosign-archives
    output: true
    cmd: cosign
    artifacts: archive
    ids:
      - darwin-archive
    certificate: "{{ .Env.artifact }}.cert"
    args:
      - "sign-blob"
      - "--yes"
      - "--output-signature={{ .Env.signature }}"
      - "--output-certificate={{ .Env.certificate }}"
      - "{{ .Env.artifact }}"
    env:
      - COSIGN_EXPERIMENTAL=1
  # Note: checksums signing moved to publish-release-manifest
  # to allow merging with the linux and Windows hashes first
# Note: the Homebrew formula is generated by cmd/generate-brew-formula in the
# publish-release-manifest job. GoReleaser can only see the darwin archives from
# this run, so it can no longer render the on_linux blocks the tap requires.
changelog:
  filters:
    exclude:
      - "^docs:"
      - typo
      - lint
      - Merge pull request
